# Variables de entorno de fase 1 (design.md A2). Copiar a .env.local y
# completar con los valores reales del proyecto.

# Cliente + servidor — URL y clave publicable del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Cliente + servidor — usada en redirects de OAuth y links de los correos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor. Operaciones administrativas de Supabase. NUNCA se prefija
# con NEXT_PUBLIC_, nunca se pasa a un componente cliente y nunca se loguea:
# expone acceso total a la base sin pasar por RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Solo servidor. Confirmación de cuenta y reset de contraseña.
RESEND_API_KEY=

# Fase 2 (D7, decisión D-C de openspec/changes/fase-2-potencia/design.md).
# Claves VAPID de recordatorios push: un único par por proyecto, generado
# una vez con `npx web-push generate-vapid-keys` y no se vuelve a cambiar
# — rotarlo invalida todas las suscripciones existentes, que se recrean
# solas la próxima vez que cada dispositivo reactive los recordatorios.

# Cliente (Vercel). Clave pública, va en el navegador al suscribir el
# dispositivo (`lib/reminders/subscribe.ts`).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Solo la edge function `supabase/functions/enviar-recordatorios/` (secreto
# de Supabase, no de Vercel: `supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...`).
# Misma clave pública que arriba, más la privada, que nunca sale del
# servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@trazio.app

# Fase 4 (decisiones D-A y D-B de openspec/changes/fase-4-calendario/design.md).
# Conexión con Google Calendar. Trámite manual en la consola de Google Cloud,
# ver docs/setup-google-calendar.md paso a paso.

# Solo servidor. GOOGLE_CLIENT_SECRET nunca se prefija con NEXT_PUBLIC_, nunca
# se pasa a un componente cliente y nunca se loguea — mismo tratamiento que
# SUPABASE_SERVICE_ROLE_KEY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Solo servidor. Cifra el refresh token de Google antes de guardarlo en
# `calendar_connections` (lib/calendar/crypto.ts). 32 bytes en base64,
# generados una vez con `openssl rand -base64 32`. Si se pierde, cada usuario
# tiene que reconectar su calendario: no hay forma de recuperar los tokens ya
# guardados.
CALENDAR_REFRESH_TOKEN_ENCRYPTION_KEY=
